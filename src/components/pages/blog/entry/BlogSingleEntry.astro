---
import { documentToHtmlString } from "@contentful/rich-text-html-renderer";
import { type Document } from "@contentful/rich-text-types";
import BlogLayout from "@layouts/BlogLayout.astro";

import CoverImage from "./CoverImage.astro";
import { parseContentfulContentOptions } from "@lib/contentful";
import { getLanguageFromUrl } from "@lib/getLanguageFromUrl";
import { getTranslationsByLanguage } from "@i18n/utils";

interface Props {
  title: string;
  excerpt: Document;
  body: Document;
  coverImageUrl?: string;
  coverImageWidth?: number;
  coverImageHeight?: number;
  switchLocaleLink?: string;
}

const userLanguage = getLanguageFromUrl(Astro.url);
const translations = getTranslationsByLanguage(userLanguage);

const {
  title,
  excerpt,
  body,
  coverImageUrl,
  coverImageWidth,
  coverImageHeight,
  switchLocaleLink,
} = Astro.props;

const switchLocaleLinkWithParams = switchLocaleLink ? 
  `${switchLocaleLink}${Astro.url.search}` : undefined;

const bodyHtmlContent = documentToHtmlString(
  body,
  parseContentfulContentOptions
);
---

<BlogLayout title={title}>
  {
    coverImageUrl && (
      <CoverImage
        url={coverImageUrl}
        width={coverImageWidth}
        height={coverImageHeight}
      />
    )
  }
  <div class="relative container mt-2 mb-0 flex flex-col bg-backgroundDark/80 backdrop-blur-[8px] pt-4">
    {switchLocaleLinkWithParams && (
      <a href={switchLocaleLinkWithParams} class="block mb-3">
        &raquo; {translations.entry.SWITCH_LOCALE_TEXT}
      </a>
    )}
    <h2
      class="text-body-light"
    >
      {title}
    </h2>
    <div
      class="blog-content z-10 mb-4 pt-6 pb-12"
    >
      <div
        class="mt-2 mb-10 text-lg"
        set:html={excerpt}
      />
      <div set:html={bodyHtmlContent} />
    </div>
  </div>
</BlogLayout>
<script>
  import Prism from "prismjs";
  import "prismjs/components/prism-typescript";

  Prism.manual = true;

  document.addEventListener("astro:page-load", () => {
    Prism.highlightAll();
  });
</script>
